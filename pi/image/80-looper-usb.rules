# LoopSmith: the USB drive is the loop/recording library at /media/usb
ACTION=="add",    SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", RUN+="/opt/looper/pi/usb-mount.sh add $env{DEVNAME} $env{ID_FS_TYPE}"
ACTION=="remove", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", RUN+="/opt/looper/pi/usb-mount.sh remove $env{DEVNAME} $env{ID_FS_TYPE}"
